# Fractal API and worker environment contract
#
# This file intentionally names every variable accepted by src/config/env.ts.
# `pnpm --filter @fractal/api check:env-contract` blocks schema/documentation
# drift. Copy this file into a secret-managed environment; never commit values.
# Production-only requirements are enforced at process boot.

# Runtime and public origins
NODE_ENV=development
PORT=4000
APP_BASE_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000

# MongoDB — the URI must include the intended database name. The runtime and
# migrate-mongo both use that name; neither silently substitutes `fractal`.
MONGODB_URI=mongodb://localhost:27017/fractal?replicaSet=rs0
MONGODB_POOL_SIZE=20
MONGODB_READ_PREFERENCE=primary
MONGODB_SLOW_QUERY_LOG=false
MONGODB_SLOW_QUERY_THRESHOLD_MS=200

# PostgreSQL — required in production and authoritative for identity, sessions,
# governed workflows, journals, inbox/outbox commands, and audit records.
DATABASE_URL=postgresql://fractal:fractal@localhost:5432/fractal_platform_dev
POSTGRES_POOL_SIZE=20
POSTGRES_SSL=false
POSTGRES_REQUIRED=false

# Redis — required in production for distributed rate limits, queues, leases,
# and worker coordination. Use a dedicated namespace/database per environment.
REDIS_URL=redis://localhost:6379/0
RATE_LIMIT_REDIS_ENABLED=true
WORKER_LEASE_KEY=fractal:worker-runtime:lease
WORKER_LEASE_TTL_MS=60000

# Authentication, cookie sessions, and key rotation
JWT_SECRET=dev-secret-change-me-must-be-32chars-minimum
JWT_ACTIVE_KEY_ID=primary
# JSON object mapping verification key IDs to 32+ character secrets.
JWT_KEY_RING_JSON=
# Exact SHA-256 identity for the deployed application release.
APPLICATION_RELEASE_SHA256=
# Exact SHA-256 identity for the deployed public-chain privacy adapter artifact.
PRIVACY_CHAIN_ADAPTER_SHA256=
# Exact SHA-256 identity for the deployed Resend privacy adapter artifact.
PRIVACY_RESEND_ADAPTER_SHA256=
# Exact SHA-256 identity for the deployed Sumsub privacy adapter artifact.
PRIVACY_SUMSUB_ADAPTER_SHA256=
# Separate read-only key for the Resend privacy collection worker.
PRIVACY_RESEND_COLLECTION_API_KEY=
# Separate read-only credentials for the Sumsub privacy collection worker.
SUMSUB_PRIVACY_APP_TOKEN=
SUMSUB_PRIVACY_SECRET_KEY=
# JSON object that maps attestation key IDs to Ed25519 public keys and status.
# Example record: {"probe-2026-01":{"publicKeyPem":"-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----","status":"active"}}
PRIVACY_EXTERNAL_ATTESTATION_KEY_RING_JSON=
AUTH_ACCESS_TOKEN_TTL_SECONDS=900
AUTH_REFRESH_TOKEN_TTL_DAYS=30
AUTH_STEP_UP_TTL_SECONDS=900
# Production must use postgres. Mongo is an explicit migration bridge only.
AUTH_IDENTITY_AUTHORITY=mongo
MFA_TOTP_ENABLED=false
# Separate 64-character hexadecimal values; required when MFA is enabled.
MFA_TOTP_ENCRYPTION_KEY=
MFA_RECOVERY_CODE_PEPPER=

# Durable transactional email delivery. Production requires Resend and the
# dispatcher. SMTP is a local-development fallback only. EMAIL_FROM must be a
# verified Resend sender.
NOTIFICATION_EMAIL_ENABLED=true
NOTIFICATION_EMAIL_POLL_INTERVAL_MS=15000
NOTIFICATION_EMAIL_MAX_RETRIES=3
EMAIL_FROM=
RESEND_API_KEY=
# Separate 32+ character key. Keep it stable across API and worker releases.
EMAIL_DELIVERY_SECRET_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
AUTH_EMAIL_DELIVERY_ENABLED=true
AUTH_EMAIL_DELIVERY_INTERVAL_MS=1000
AUTH_EMAIL_DELIVERY_BATCH_SIZE=50
AUTH_EMAIL_DELIVERY_CLAIM_TIMEOUT_SECONDS=300
AUTH_EMAIL_DELIVERY_RETRY_BASE_SECONDS=10
AUTH_EMAIL_DELIVERY_MAX_ATTEMPTS=12
AUTH_EMAIL_DELIVERY_MAX_PENDING_AGE_SECONDS=900
AUTH_EMAIL_DELIVERY_HEALTH_LOG_INTERVAL_MS=60000

# One-shot administrator ceremonies. Keep unset in API/worker runtimes. Inject
# only into the relevant access-logged job, then remove immediately afterward.
ADMIN_BOOTSTRAP_COHORT_JSON=
ADMIN_OPERATIONS_ACTOR_ID=
ADMIN_BREAK_GLASS_REQUEST_KEY=
ADMIN_BREAK_GLASS_APPROVAL_KEY=
ADMIN_RECOVERY_REQUEST_JSON=

# Private document storage and malware scanning.
#
# Staging:
# - Use FILE_STORAGE_PROVIDER=cloudinary when you want uploads in Cloudinary.
# - Keep FILE_STORAGE_FALLBACK_TO_LOCAL=true only if local backup storage is OK.
# - Keep MALWARE_SCAN_REQUIRED=false until you deploy a scanner service.
#
# Production:
# - Use FILE_STORAGE_PROVIDER=s3.
# - Set FILE_STORAGE_FALLBACK_TO_LOCAL=false.
# - Set MALWARE_SCAN_REQUIRED=true.
# - Set MALWARE_SCAN_HOST to a reachable scanner service.
# - Set all S3_* fields below.
#
# Reason:
# Cloudinary is public-media storage. It is useful for staging media uploads.
# It is not accepted for regulated private documents in production.
FILE_STORAGE_PROVIDER=local
FILE_STORAGE_FALLBACK_TO_LOCAL=true
FILE_STORAGE_DIR=storage
MALWARE_SCAN_REQUIRED=false
MALWARE_SCAN_HOST=
MALWARE_SCAN_PORT=3310
MALWARE_SCAN_TIMEOUT_MS=15000

# Cloudinary storage. Use this for staging uploads.
# Do not use this as production private document storage.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_FOLDER=fractal

# S3-compatible private object storage.
# Required only when NODE_ENV=production.
#
# S3_BUCKET is the private bucket name.
# S3_REGION is the provider region.
# S3_ENDPOINT is optional. Set it for non-AWS S3-compatible providers.
# S3_ACCESS_KEY_ID is the storage access key.
# S3_SECRET_ACCESS_KEY is the storage secret key.
# S3_SESSION_TOKEN is optional. Set it only for temporary credentials.
# S3_KMS_KEY_ID is the encryption key ID. Production requires it.
# S3_FORCE_PATH_STYLE is usually false for AWS S3. Some S3-compatible providers
# require true.
# S3_KEY_PREFIX is the folder prefix for Fractal objects.
S3_BUCKET=
S3_REGION=us-east-1
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_SESSION_TOKEN=
S3_KMS_KEY_ID=
S3_FORCE_PATH_STYLE=false
S3_KEY_PREFIX=fractal

# Paystack payments. Disable only for an environment that intentionally does
# not expose payment capabilities. Production requires the durable inbox.
PAYSTACK_ENABLED=true
PAYSTACK_SECRET_KEY=
PAYSTACK_WEBHOOK_SECRET=
PAYSTACK_INBOX_ENABLED=true
PAYSTACK_DVA_ENABLED=false
PAYSTACK_DVA_PREFERRED_BANK=
PAYSTACK_TRANSFER_WEBHOOK_TIMEOUT_MS=86400000
PAYSTACK_BALANCE_CHECK_ENABLED=true
PAYSTACK_REQUEST_TIMEOUT_MS=10000

# Sumsub identity/business verification. Production requires signed webhooks
# and the durable inbox whenever verification capabilities are enabled.
SUMSUB_ENABLED=true
SUMSUB_APP_TOKEN=
SUMSUB_SECRET_KEY=
SUMSUB_WEBHOOK_SECRET=
SUMSUB_LEVEL_NAME=basic-kyc-level
SUMSUB_REQUEST_TIMEOUT_MS=10000
SUMSUB_SDK_TOKEN_TTL_SECONDS=600
SUMSUB_INBOX_ENABLED=true

# Optional embedded-wallet provider. No fake address fallback exists.
PRIVY_ENABLED=false
PRIVY_APP_ID=
PRIVY_APP_SECRET=

# Durable PostgreSQL dispatchers and recovery workers
OUTBOX_DISPATCH_ENABLED=true
OUTBOX_DISPATCH_INTERVAL_MS=1000
OUTBOX_DISPATCH_BATCH_SIZE=50
OUTBOX_CLAIM_TIMEOUT_SECONDS=300
OUTBOX_RETRY_BASE_SECONDS=10
INBOX_DISPATCH_INTERVAL_MS=1000
INBOX_DISPATCH_BATCH_SIZE=50
INBOX_CLAIM_TIMEOUT_SECONDS=300
INBOX_RETRY_BASE_SECONDS=10
INBOX_MAX_ATTEMPTS=12
STORAGE_CLEANUP_INTERVAL_MS=5000
STORAGE_CLEANUP_BATCH_SIZE=50
STORAGE_CLEANUP_CLAIM_TIMEOUT_SECONDS=300
STORAGE_CLEANUP_RETRY_BASE_SECONDS=10
STORAGE_CLEANUP_MAX_ATTEMPTS=12
PRIVACY_PACKAGE_WORKER_ENABLED=true
PRIVACY_PACKAGE_WORKER_INTERVAL_MS=5000
PRIVACY_PACKAGE_WORKER_BATCH_SIZE=10
PRIVACY_EXTERNAL_COLLECTION_WORKER_ENABLED=false
PRIVACY_EXTERNAL_COLLECTION_WORKER_INTERVAL_MS=5000
PRIVACY_EXTERNAL_COLLECTION_WORKER_BATCH_SIZE=10
PAYMENT_INSTRUCTION_DISPATCH_INTERVAL_MS=1000
PAYMENT_INSTRUCTION_CLAIM_TIMEOUT_SECONDS=300
PAYMENT_INSTRUCTION_RETRY_BASE_SECONDS=10
PAYMENT_INSTRUCTION_MAX_ATTEMPTS=12
IDENTITY_VERIFICATION_APPLICATION_DISPATCH_INTERVAL_MS=1000
IDENTITY_VERIFICATION_APPLICATION_CLAIM_TIMEOUT_SECONDS=300
IDENTITY_VERIFICATION_APPLICATION_RETRY_BASE_SECONDS=10
IDENTITY_VERIFICATION_APPLICATION_MAX_ATTEMPTS=12
PROFESSIONAL_PAYOUT_DISPATCH_INTERVAL_MS=10000
PROFESSIONAL_PAYOUT_DISPATCH_LEASE_TIMEOUT_SECONDS=600
PROFESSIONAL_PAYOUT_RECONCILIATION_INTERVAL_MS=60000
PROFESSIONAL_PAYOUT_RECONCILIATION_BATCH_SIZE=100
DISTRIBUTION_PAYOUT_DISPATCH_INTERVAL_MS=10000
DISTRIBUTION_PAYOUT_DISPATCH_LEASE_TIMEOUT_SECONDS=600
DISTRIBUTION_PAYOUT_RECONCILIATION_INTERVAL_MS=60000
DISTRIBUTION_PAYOUT_RECONCILIATION_BATCH_SIZE=100
PAYMENT_EXPIRY_INTERVAL_MS=30000
PLATFORM_CONFIGURATION_ACTIVATION_INTERVAL_MS=1000
PLATFORM_CONFIGURATION_ACTIVATION_BATCH_SIZE=25
PLATFORM_CONTENT_PUBLICATION_INTERVAL_MS=1000
SUPPORT_SERVICE_SWEEP_INTERVAL_MS=60000
SUPPORT_SERVICE_SWEEP_BATCH_SIZE=100
PLATFORM_CONTENT_PUBLICATION_BATCH_SIZE=25
PAYMENT_EXPIRY_BATCH_SIZE=100

# Legacy/background schedules. The production worker disables Mongo-backed
# automation until each job has a durable PostgreSQL replacement.
RECONCILIATION_WORKER_ENABLED=true
RECONCILIATION_INTERVAL_MS=300000
RECONCILIATION_TOLERANCE=0.5
WORK_ORDER_SLA_ESCALATION_ENABLED=true
WORK_ORDER_SLA_ESCALATION_INTERVAL_MS=300000
WORK_ORDER_SLA_ESCALATION_BATCH_LIMIT=100

# Optional audit-anchor worker. Environment private keys are not permitted for
# production value-bearing execution.
ANCHOR_WORKER_ENABLED=false
ANCHOR_RPC_URL=
ANCHOR_CHAIN_ID=11155111
ANCHOR_CONTRACT_ADDRESS=
ANCHOR_PRIVATE_KEY=
ANCHOR_POLL_INTERVAL_MS=30000
ANCHOR_CONFIRMATIONS=1

# EVM network and execution. `aws_kms` and `vault` are reserved labels and fail
# closed until their non-exporting signer adapters are implemented and reviewed.
KEY_MANAGEMENT_PROVIDER=env
POLYGON_RPC_URL=https://polygon-rpc.com
POLYGON_AMOY_RPC_URL=https://rpc-amoy.polygon.technology
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
FRACTAL_AGENT_PRIVATE_KEY=
# Deprecated contract-tooling compatibility input; prefer FRACTAL_AGENT_PRIVATE_KEY.
PRIVATE_KEY=
FRACTAL_AGENT_ADDRESS=
BLOCKCHAIN_WORKER_ENABLED=false
LEGACY_BLOCKCHAIN_AUTOMATION_ENABLED=false
CHAIN_DEPLOYMENT_EXECUTOR_ENABLED=false
CHAIN_DEPLOYMENT_DISPATCH_INTERVAL_MS=15000
CHAIN_DEPLOYMENT_DISPATCH_BATCH_SIZE=1
ALLOCATION_CHAIN_EXECUTOR_ENABLED=false
ALLOCATION_CHAIN_DISPATCH_INTERVAL_MS=15000
ALLOCATION_CHAIN_DISPATCH_BATCH_SIZE=1
BLOCKCHAIN_POLL_INTERVAL_MS=15000
BLOCKCHAIN_CONFIRMATIONS=2
BLOCKCHAIN_MAX_RETRIES=3
CHAIN_ID=80002
TOKEN_FACTORY_ADDRESS=
IDENTITY_REGISTRY_ADDRESS=
IDENTITY_FACTORY_ADDRESS=
CLAIM_ISSUER_ADDRESS=
AGENT_REGISTRY_ADDRESS=
DISTRIBUTION_AUDIT_ADDRESS=
USDT_ADDRESS=

# Observability and application-layer encryption
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_TRACE_SAMPLE_RATE=0.1
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
FIELD_ENCRYPTION_ENABLED=false
# 64-character hexadecimal key; required when field encryption is enabled.
FIELD_ENCRYPTION_KEY=
