# Fractal independent Resend privacy probe
#
# Run this process outside the API and worker environment.
# Use a read-only PostgreSQL account.
# Use a separate Resend API key that can retrieve sent email records.
# Do not put a signing private key in this file.

PRIVACY_PROBE_DATABASE_URL=postgresql://privacy_probe:replace@db.example/fractal
PRIVACY_PROBE_DATABASE_SSL=true
PRIVACY_PROBE_RESEND_API_KEY=

# Use an absolute path to an approved signer program.
# The program reads canonical payload bytes from standard input.
# The program writes one base64 Ed25519 signature to standard output.
PRIVACY_PROBE_SIGNER_EXECUTABLE=
PRIVACY_PROBE_SIGNER_ARGS_JSON=[]
# Pass only the variables that the signer needs.
# The probe does not pass its PostgreSQL or Resend credentials to the signer.
PRIVACY_PROBE_SIGNER_ENV_JSON={}
PRIVACY_PROBE_SIGNER_TIMEOUT_MS=15000
