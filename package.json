{
  "name": "@fractal/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --exclude '**/node_modules/**' --exclude '../../node_modules/**' src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --import ./dist/instrumentation.js dist/server.js",
    "worker": "tsx src/worker.ts",
    "worker:start": "node --import ./dist/instrumentation.js dist/worker.js",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:integration:isolated": "node --env-file-if-exists=.env scripts/run-isolated-runtime-integration.mjs",
    "test:postgres": "vitest run --config vitest.postgres.config.ts",
    "seed:browser-e2e": "tsx scripts/seed-browser-e2e.ts",
    "check:env-contract": "tsx scripts/check-env-contract.ts",
    "check:openapi-contract": "tsx scripts/check-openapi-contract.ts",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "migrate:up": "migrate-mongo up",
    "migrate:down": "migrate-mongo down",
    "migrate:status": "migrate-mongo status",
    "migrate:create": "migrate-mongo create",
    "db:postgres:migrate": "tsx src/migrate-postgres.ts",
    "db:postgres:status": "tsx src/migrate-postgres.ts --status",
    "db:identity:backfill": "tsx src/migrate-identities.ts",
    "db:identity:verify": "tsx src/verify-identity-backfill.ts",
    "db:audit:verify": "tsx src/verify-postgres-audit.ts",
    "db:privacy-inventory:verify": "tsx src/verify-privacy-data-inventory.ts",
    "privacy:probe": "tsx src/privacy-probe.ts",
    "admin:operations": "tsx src/admin-operations.ts",
    "testnet:chain-executor:sepolia": "tsx src/exercise-sepolia-offering-chain-executor.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^10.0.1",
    "@fastify/helmet": "^13.0.2",
    "@fastify/jwt": "^9.1.0",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/swagger": "^9.5.1",
    "@fastify/swagger-ui": "^5.2.2",
    "@opentelemetry/auto-instrumentations-node": "^0.72.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.214.0",
    "@opentelemetry/sdk-node": "^0.214.0",
    "@sentry/node": "^10.60.0",
    "bcrypt": "^6.0.0",
    "bullmq": "^5.72.0",
    "dotenv": "^16.6.1",
    "fastify": "^5.6.1",
    "fastify-plugin": "^5.1.0",
    "ioredis": "^5.10.1",
    "migrate-mongo": "^14.0.7",
    "mongoose": "^8.19.4",
    "nodemailer": "^7.0.10",
    "opossum": "^9.0.0",
    "pg": "^8.16.3",
    "resend": "^6.9.1",
    "viem": "^2.38.0",
    "yauzl": "3.4.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/node": "^22.18.10",
    "@types/opossum": "^8.1.9",
    "@types/pg": "^8.15.6",
    "@types/yauzl": "3.4.0",
    "@types/yazl": "3.3.1",
    "@vitest/coverage-v8": "^2.0.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.3",
    "vitest": "^2.0.0",
    "yazl": "3.3.1"
  }
}
